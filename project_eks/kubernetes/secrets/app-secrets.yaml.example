# IMPORTANT: This is an example file. DO NOT commit actual secrets!
# Create the actual secret using kubectl create secret command

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: virusprotect
type: Opaque
stringData:
  # VirusTotal API Key
  VT_API_KEY: "your_virustotal_api_key_here"
  
  # Database Connection (from AWS Secrets Manager or direct)
  DATABASE_URL: "postgresql://user:password@virusprotect-db.abc123.us-east-1.rds.amazonaws.com:5432/virusprotect"
  DB_USERNAME: "virusprotect_admin"
  DB_PASSWORD: "your_db_password_here"
  
  # OpenSearch Credentials
  OPENSEARCH_USERNAME: "admin"
  OPENSEARCH_PASSWORD: "your_opensearch_password_here"
  
  # JWT Secret for authentication
  JWT_SECRET: "your_jwt_secret_here_use_openssl_rand_base64_32"
  
  # AWS Secrets Manager ARNs (alternative to direct secrets)
  AWS_SECRET_RDS_ARN: "arn:aws:secretsmanager:us-east-1:123456789012:secret:virusprotect/rds/credentials-xxxxxx"
  AWS_SECRET_OPENSEARCH_ARN: "arn:aws:secretsmanager:us-east-1:123456789012:secret:virusprotect/opensearch/credentials-xxxxxx"
  AWS_SECRET_VT_ARN: "arn:aws:secretsmanager:us-east-1:123456789012:secret:virusprotect/virustotal/api-key-xxxxxx"

---
# How to create the secret from command line:
# 
# kubectl create secret generic app-secrets \
#   --from-literal=VT_API_KEY="your_key" \
#   --from-literal=DATABASE_URL="postgresql://..." \
#   --from-literal=OPENSEARCH_USERNAME="admin" \
#   --from-literal=OPENSEARCH_PASSWORD="password" \
#   --from-literal=JWT_SECRET="$(openssl rand -base64 32)" \
#   -n virusprotect
#
# Or use AWS Secrets Manager with External Secrets Operator:
# https://external-secrets.io/latest/
